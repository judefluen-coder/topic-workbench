YOUTUBE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker Compose uses this address to reach Ollama on the host machine.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
LOCAL_ASR_ENABLED=false
ARGOS_TRANSLATE_ENABLED=true
ARGOS_AUTO_INSTALL=true
PLACEHOLDER_TRANSLATION_ENABLED=false
DOWNLOAD_ENGINE=yt-dlp
YTDLP_PATH=yt-dlp
LOCAL_YTDLP_DISCOVERY=true
OPENCLI_DISCOVERY_ENABLED=true
OPENCLI_PATH=opencli
OPENCLI_WINDOW_MODE=background
OPENCLI_PREFLIGHT_ENABLED=false
BILIBILI_DISCOVERY_ENABLED=true
BILIBILI_CHANNEL_UIDS=
BILIBILI_CHANNEL_SCAN_LIMIT=2
DOWNLOAD_DIR=storage/downloads
TOPIC_WORKBENCH_DB_PATH=storage/app.db
TOPIC_WORKBENCH_UPLOAD_DIR=storage/uploads
TOPIC_WORKBENCH_EXPORT_DIR=storage/exports
TOPIC_WORKBENCH_TMP_DIR=storage/tmp
TOPIC_WORKBENCH_DEFAULT_MEDIA_DELETE_AFTER_PROCESSING=true
TOPIC_WORKBENCH_WORKER_POLL_SECONDS=0.8

# Optional paid cloud fallback. Leave disabled unless you explicitly want it.
CLOUD_AI_ENABLED=false
OPENAI_API_KEY=
